{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    "public/draco"
  ],
  // src/three: react-three-fiber mutates imperative three.js objects (materials, buffers)
  // every frame by design; the React Compiler state rules do not apply to them.
  "overrides": [
    {
      "files": [
        "src/three/**"
      ],
      "rules": {
        "react/immutability": "off",
        "react/refs": "off"
      }
    }
  ]
}
